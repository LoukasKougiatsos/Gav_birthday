# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored; never commit real keys.

# --- Phase 5: password protection for the whole site ---
# SITE_PASSWORD=

# --- Phase 4: Plants — Perenual plant care API ---
# PERENUAL_API_KEY=

# --- Phase 4: Kitchen — Spoonacular meal planning / nutrition API ---
# SPOONACULAR_API_KEY=

# --- Phase 3: Animals — The Dog API (weekly dachshund) ---
# THE_DOG_API_KEY=

# No key needed (used directly from the browser): Open-Meteo, iNaturalist,
# TheMealDB, Overpass/OpenStreetMap, Wikipedia GeoSearch, xeno-canto,
# random.dog. ZenQuotes is keyless but CORS-restricted, so it's called from
# a serverless route instead.
